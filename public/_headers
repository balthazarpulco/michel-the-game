# Cache headers for Netlify and Cloudflare Pages (both read this file at the root of dist/).
# assets/ (Vite) and gen/ (tools/assets.mjs) only contain files with a content hash in their name: cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/gen/*
  Cache-Control: public, max-age=31536000, immutable
# videos and icons keep their names: one day, then the browser checks again
/*.mp4
  Cache-Control: public, max-age=86400
/*.webm
  Cache-Control: public, max-age=86400
/meta/*
  Cache-Control: public, max-age=86400
